#Standardize the scientific names
#The function below removes strain and isolate information and retains a canonical binomial name when available.

canonical_species <- function(x) {

  x <- str_replace_all(
    x,
    regex(
      "\\b(CBS|ATCC|DSM|NRRL|JCM|IFO|strain|isolate)\\b.*",
      ignore_case = TRUE
    ),
    ""
  )

  x <- str_squish(x)

  matched_name <- str_match(
    x,
    "^([A-Z][A-Za-z_-]+)\\s+([a-z][A-Za-z0-9_-]+)"
  )

  ifelse(
    is.na(matched_name[, 1]),
    NA_character_,
    matched_name[, 1]
  )
}


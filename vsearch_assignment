#Trimming primers from Nanopore data
#Forward primer: CTTGGTCATTTAGAGGAAGTAA
#Reverse primer: GCTGCGTTCTTCATCGATGC

#Open a terminal.
#If you are using Windows, open the WSL (Windows Subsystem for Linux) terminal.

#The same workflow applies to all scripts

#Create the script:
nano cutadapt_nanopore.sh

#!/bin/bash
set -euo pipefail

FWD="CTTGGTCATTTAGAGGAAGTAA"
REV="GCTGCGTTCTTCATCGATGC"
FWD_RC="TTACTTCCTCTAAATGACCAAG"
REV_RC="GCATCGATGAAGAACGCAGC"

INPUT_DIR="."
OUTDIR="1_cutadapt"
mkdir -p "$OUTDIR"

for f in *.fastq.gz; do
    base=$(basename "$f" .fastq.gz)
    cutadapt \
        --cores=0 \
        -g "$FWD" -g "$FWD_RC" \
        -a "$REV_RC" -a "$REV" \
        --overlap 8 \
        --times 2 \
        -e 0.20 \
        --minimum-length 50 \
        -o "$OUTDIR/${base}.cut.fastq.gz" \
        "$f"
done

echo "Cutadapt terminado."

#Save:
Ctrl + O

#Exit:
Ctrl + X

#Make the script executable:
sudo chmod +x cutadapt_nanopore.sh

# Length-based pre-filtering of samples

#seqkit.sh
#!/bin/bash

# SeqKit script
# Pre-filter all FASTQ files in the input directory
# Filter reads by length and quality

INPUT_DIR="~/Nanopore/Nanopore/cutadapt"
OUTDIR="~/Nanopore/Nanopore/cutadapt/seqkit"
mkdir -p "$OUTDIR"

MINLEN=200
MAXLEN=350    # Recommended truncation length for ONT–Illumina integration
QTHRESH=12

for f in $INPUT_DIR/*.fastq.gz; do
    base=$(basename "$f" .cut.fastq.gz)

    seqkit seq "$f" --max-len $MAXLEN \
    | seqkit seq --min-len $MINLEN \
    | seqkit seq -Q $QTHRESH \
    | gzip > "$OUTDIR/${base}.filtered.fastq.gz"
done

echo "Length and quality filtering completed."


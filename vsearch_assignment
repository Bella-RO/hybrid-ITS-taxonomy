#Define the assignment selection rule

choose_taxonomy <- function(sintax_tax, pass, lca_tax, blast_tax) {

  if (
    !is.na(sintax_tax) &&
    sintax_tax != "" &&
    !is.na(pass) &&
    pass == "+"
  ) {
    return(sintax_tax)
  }

  if (
    !is.na(lca_tax) &&
    lca_tax != ""
  ) {
    return(lca_tax)
  }

  if (
    !is.na(blast_tax) &&
    blast_tax != ""
  ) {
    return(blast_tax)
  }

  return(NA_character_)
}



#Extract each taxonomic rank

extract_rank <- function(taxonomy, rank_prefix) {

  if (
    is.na(taxonomy) ||
    taxonomy == ""
  ) {
    return(NA_character_)
  }

  entries <- unlist(
    strsplit(taxonomy, ",")
  )

  match <- entries[
    startsWith(entries, rank_prefix)
  ]

  if (length(match) == 0) {
    return(NA_character_)
  }

  sub(
    paste0("^", rank_prefix),
    "",
    match[1]
  )
}


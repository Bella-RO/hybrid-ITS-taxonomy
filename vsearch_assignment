# Function to calculate the Lowest Common Ancestor
calc_lca <- function(tax_strings) {

  tax_strings <- tax_strings[
    !is.na(tax_strings) & tax_strings != ""
  ]

  if (length(tax_strings) == 0) {
    return(NA_character_)
  }

  levels <- c(
    "d:",
    "p:",
    "c:",
    "o:",
    "f:",
    "g:",
    "s:"
  )

  lca <- character()
  taxonomic_parts <- strsplit(tax_strings, ",")

  for (level in levels) {

    candidates <- unique(
      grep(
        paste0("^", level),
        trimws(unlist(taxonomic_parts)),
        value = TRUE
      )
    )

    # Retain the taxonomic level only when all hits agree
    if (length(candidates) == 1) {
      lca <- c(lca, candidates)
    } else {
      break
    }
  }

  paste(lca, collapse = ",")
}

# Join alignments with the reference taxonomy,
# filter the retained hits, and calculate the LCA
hits <- b6 %>%
  left_join(
    taxmap,
    by = c("RefAcc" = "Ref")
  ) %>%
  filter(
    PID >= 80,
    AlnLen >= 150,
    !is.na(Taxonomy)
  ) %>%
  group_by(OTU) %>%
  summarise(
    LCA = calc_lca(Taxonomy),
    Number_of_hits = n(),
    .groups = "drop"
  )

# Export the final LCA taxonomic assignment table
write.table(
  hits,
  "otus090.lca.tsv",
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)


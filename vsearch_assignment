#Dereplicate sequences and remove chimeras

#chimeras_nano.sh
#!/usr/bin/env bash
set -euo pipefail
shopt -s nullglob

FASTA_DIR="/mnt/d/HongosAN/Antartica/OBJ1/100REALNOFAKE/Secuencias_NOBORRARLASOTRAS/nanopore/fasta"
WORK="$FASTA_DIR/work_globalchim1"
OUT="$FASTA_DIR/globalchim_out1"

mkdir -p "$WORK" "$OUT"

# Create an empty file containing all Nanopore sequences
> "$WORK/nanopore.all.fa"

# Identify all filtered FASTA files
FILES=( "$FASTA_DIR"/*.filtered.fasta )

# Stop the script if no input files are found
if (( ${#FILES[@]} == 0 )); then
  echo "ERROR: No *.filtered.fasta files were found in $FASTA_DIR" >&2
  exit 1
fi

# Concatenate all filtered FASTA files
for fa in "${FILES[@]}"; do
  cat "$fa" >> "$WORK/nanopore.all.fa"
done

# Sort sequences by length
vsearch --quiet \
  --sortbylength "$WORK/nanopore.all.fa" \
  --output "$WORK/nanopore.all.sorted.fa"

# Dereplicate identical full-length sequences
vsearch \
  --derep_fulllength "$WORK/nanopore.all.sorted.fa" \
  --output "$WORK/nanopore.all.derep.fa" \
  --sizeout

# Perform de novo chimera detection
vsearch \
  --uchime_denovo "$WORK/nanopore.all.derep.fa" \
  --nonchimeras "$OUT/nanopore.nochim.derep.fa" \
  --chimeras "$OUT/nanopore.chim.derep.fa" \
  --borderline "$OUT/nanopore.border.derep.fa" \
  --uchimeout "$OUT/nanopore.uchime.txt"

# Report the number of unique sequences in each category
echo "✓ Global non-chimeric Nanopore sequences: $(grep -c '^>' "$OUT/nanopore.nochim.derep.fa")"
echo "✓ Global chimeric Nanopore sequences:     $(grep -c '^>' "$OUT/nanopore.chim.derep.fa")"
echo "✓ Global borderline Nanopore sequences:   $(grep -c '^>' "$OUT/nanopore.border.derep.fa")"

# Report the total abundance represented by non-chimeric sequences
echo "Non-chimeric reads:"
grep "^>" "$OUT/nanopore.nochim.derep.fa" | \
sed -n 's/.*;size=\([0-9]*\).*/\1/p' | \
awk '{sum+=$1} END{print sum+0}'

# Report the total abundance represented by chimeric sequences
echo "Chimeric reads:"
grep "^>" "$OUT/nanopore.chim.derep.fa" | \
sed -n 's/.*;size=\([0-9]*\).*/\1/p' | \
awk '{sum+=$1} END{print sum+0}'


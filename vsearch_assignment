#Calculate the LCA assignment**
#LCA ANALYSIS AND INTEGRATION WITH REFERENCE TAXONOMY

library(tidyverse)

# Set the working directory
setwd(
  "\\\\wsl$\\Ubuntu\\home\\bellaro\\hongos\\results\\asignacion\\LCA"
)

getwd()
list.files()

# Read the VSEARCH alignment output
b6 <- read.delim(
  "otus090.lca.b6",
  header = FALSE,
  stringsAsFactors = FALSE
)

# Assign BLAST6 column names
colnames(b6) <- c(
  "OTU",
  "Ref",
  "PID",
  "AlnLen",
  "Mism",
  "Gap",
  "qStart",
  "qEnd",
  "sStart",
  "sEnd",
  "E",
  "Bits",
  "RefAcc"
)

# Remove abundance information from OTU identifiers
b6$OTU <- sub(";size=.*", "", b6$OTU)

# Read the reference taxonomy table
taxmap <- read.delim(
  "refid_tax_map.tsv",
  stringsAsFactors = FALSE
)

# Extract the accession identifier from the reference header
b6 <- b6 %>%
  mutate(
    RefAcc = sub(
      "^[^|]+\\|([^|]+)\\|.*",
      "\\1",
      Ref
    )
  )

# Function to calculate the Lowest Common Ancestor
calc_lca <- function(tax_strings) {

  tax_strings <- tax_strings[
    !is.na(tax_strings) & tax_strings != ""
  ]

  if (length(tax_strings) == 0) {
    return(NA_character_)
  }

  levels <- c(
    "d:",
    "p:",
    "c:",
    "o:",
    "f:",
    "g:",
    "s:"
  )

  lca <- character()
  taxonomic_parts <- strsplit(tax_strings, ",")

  for (level in levels) {

    candidates <- unique(
      grep(
        paste0("^", level),
        trimws(unlist(taxonomic_parts)),
        value = TRUE
      )
    )

    # Retain the taxonomic level only when all hits agree
    if (length(candidates) == 1) {
      lca <- c(lca, candidates)
    } else {
      break
    }
  }

  paste(lca, collapse = ",")
}

# Join alignments with the reference taxonomy,
# filter the retained hits, and calculate the LCA
hits <- b6 %>%
  left_join(
    taxmap,
    by = c("RefAcc" = "Ref")
  ) %>%
  filter(
    PID >= 80,
    AlnLen >= 150,
    !is.na(Taxonomy)
  ) %>%
  group_by(OTU) %>%
  summarise(
    LCA = calc_lca(Taxonomy),
    Number_of_hits = n(),
    .groups = "drop"
  )

# Export the final LCA taxonomic assignment table
write.table(
  hits,
  "otus090.lca.tsv",
  sep = "\t",
  quote = FALSE,
  row.names = FALSE
)

#The final file, `otus090.lca.tsv`, contains the conservative taxonomic assignment inferred for each OTU using the Lowest Common Ancestor approach. The LCA is determined 
by comparing the taxonomic lineages of all retained reference hits. Taxonomic ranks are accepted sequentially—from domain to species—and the 
assignment stops at the first rank where the reference hits no longer agree. For example, if all retained hits agree at the family level but 
correspond to different genera, the OTU is assigned only up to the shared family. This LCA table is later integrated with the SINTAX and BLAST assignment 
results to generate the final taxonomic table used in the downstream analyses.

